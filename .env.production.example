# CareerIQ — deployed configuration.
#
# Copy to `.env.production` on the VM and fill in. That file holds secrets, is
# gitignored, and should be `chmod 600`.
#
# Every value below is either required to boot or refused in production by
# app/core/config.py's _check_production_hardening(), which collects every
# problem and reports them together. A missing one is a startup failure, not a
# runtime surprise.

# ---- the host -------------------------------------------------------------
# Caddy obtains a real certificate for this name. sslip.io resolves to the IP
# embedded in it, so HTTPS costs nothing and needs no domain:
#   34.123.45.67  ->  34-123-45-67.sslip.io
# Replace with a real domain later by changing this and the two URLs below.
SITE_ADDRESS=34-123-45-67.sslip.io

# ---- application ----------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_JSON=true
LOG_LEVEL=INFO

# ---- database -------------------------------------------------------------
# Used by compose to build both the Postgres container and DATABASE_URL, so
# they cannot disagree. Generate with: openssl rand -base64 24
POSTGRES_USER=careeriq
POSTGRES_PASSWORD=
POSTGRES_DB=careeriq
# DATABASE_URL is composed in docker-compose.prod.yml. Do not set it here.

# ---- security -------------------------------------------------------------
# At least 32 characters, and must not contain "change-me" — both enforced.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
BCRYPT_ROUNDS=12

# ---- where the app lives --------------------------------------------------
# Must be https, and must not contain "*". FRONTEND_BASE_URL is deliberately
# not derived from request headers — those are attacker-controlled, and it ends
# up in password-reset emails.
FRONTEND_BASE_URL=https://34-123-45-67.sslip.io
CORS_ORIGINS=https://34-123-45-67.sslip.io

# ---- storage --------------------------------------------------------------
# "local" is refused in production: a container's disk is the wrong place for
# somebody's resume. 5GB of Cloud Storage is free in US regions.
#
# The VM's service account needs roles/storage.objectAdmin on this bucket; the
# client picks the credentials up from the metadata server with no key file.
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=

# ---- email ----------------------------------------------------------------
# "console" is refused in production — password reset would silently never
# arrive, locking people out with no error anywhere. Brevo and Resend both have
# free tiers that need no card.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=CareerIQ

# ---- AI -------------------------------------------------------------------
# "fake" is refused in production; "none" is allowed and makes the feature
# answer 503 rather than inventing anything. Resume tailoring needs a real key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---- embeddings -----------------------------------------------------------
# "none" on purpose. The model needs ~2GB of RAM and the VM has 1GB; the
# embedder container is not deployed at all. The demo's vectors are seeded, and
# the API only ever compares them in SQL — it never loads a model.
#
# Consequence, stated rather than discovered: a resume uploaded here gets no
# embedding, so its semantic matches stay empty until something embeds it.
EMBEDDING_PROVIDER=none

# ---- jobs -----------------------------------------------------------------
# "none" so nothing fetches. The scheduler is an in-process loop that assumes a
# single process, and the demo corpus is seeded rather than fetched.
JOBS_PROVIDER=none
JOBS_AUTO_FETCH_ENABLED=false
