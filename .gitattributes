# Normalize line endings: LF in the repository, native in the working tree.
# Without this, a Windows dev and a Linux CI runner produce spurious whole-file diffs.
* text=auto

# Files that must keep LF even on Windows — they run inside Linux containers.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
docker-compose*.yml text eol=lf
.env.example    text eol=lf

# Windows-only scripts keep CRLF.
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary — never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.pkl binary
*.joblib binary
*.onnx binary
