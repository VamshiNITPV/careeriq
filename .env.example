# CareerIQ environment configuration.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed (ADR-014). This file documents
# every variable the application reads; missing required values fail loudly at
# startup rather than at first use (architecture.md §4).

# ---------------------------------------------------------------- application
APP_NAME=CareerIQ
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Host port the API is published on. Change this if something else already owns
# the port — the container always listens on 8000 internally, so nothing else
# needs to change. Find the culprit with: netstat -ano | findstr :8000
BACKEND_PORT=8000

# Host port for the Vite dev server. The browser loads the app from here and
# calls /api on this same origin, which Vite proxies to the backend — so local
# development is same-origin and never exercises CORS.
FRONTEND_PORT=5173

# ---------------------------------------------------------------- database
# Host ports the containers publish on. Change these if something already owns
# the port — a native PostgreSQL install is the usual culprit for 5432. The
# container ports never change, and services inside the compose network always
# reach `postgres:5432` / `redis:6379` regardless of what is set here.
#
# On Windows a second process CAN bind an already-used port instead of failing,
# so a clash shows up as connecting to the wrong database rather than an error.
# Verify with:  netstat -ano | findstr :5432
POSTGRES_PORT=5432
REDIS_PORT=6379

# The +asyncpg driver is required — the app uses async SQLAlchemy (ADR-004).
# docker compose overrides this to use the `postgres` hostname. This value is
# what applies when the API runs on the host instead — keep its port in sync
# with POSTGRES_PORT above.
DATABASE_URL=postgresql+asyncpg://careeriq:careeriq_dev_password@localhost:5432/careeriq
DATABASE_ECHO=false              # log every SQL statement — noisy, useful when debugging
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ---------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- security
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a different value per environment. Rotating it invalidates all sessions.
JWT_SECRET_KEY=change-me-generate-a-real-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30   # NFR / US-1.3 AC1
REFRESH_TOKEN_EXPIRE_DAYS=14     # US-1.3 AC1
BCRYPT_ROUNDS=12                 # NFR-6 — minimum 12

# ---------------------------------------------------------------- storage
# local -> filesystem, for development. gcs -> Cloud Storage (Phase 11).
# Production refuses 'local': Cloud Run has no persistent disk, so uploaded
# resumes would vanish when an instance is recycled.
STORAGE_PROVIDER=local
# Inside the container, on a named volume — never the application directory
# (ADR-014).
STORAGE_LOCAL_PATH=/var/lib/careeriq/uploads

# ---------------------------------------------------------------- email
# console -> render to the log, send nothing. No setup required; the reset link
#            appears in `docker compose logs backend`.
# smtp    -> a real SMTP server. docker compose points this at Mailpit, which
#            catches every message so development can never email a real person.
#            Read them at http://localhost:8025
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@careeriq.local
EMAIL_FROM_NAME=CareerIQ

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=5

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base URL used to build links inside emails. NOT derived from the request:
# Host and X-Forwarded-Host are attacker-controlled, and trusting them turns
# every password reset email into a phishing link (ADR-017).
FRONTEND_BASE_URL=http://localhost:5173

PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# ---------------------------------------------------------------- cors
# Explicit allow-list. Never "*" together with credentials (ADR-014).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------- logging
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # false = human-readable locally; true in deployed envs

# ---------------------------------------------------------------- ai providers
# Not used until Phase 6. Left here so the shape of the config is visible early.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=all-mpnet-base-v2
